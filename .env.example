# Copy to .env before `docker compose up`. These are local demo
# credentials for a service bound to 127.0.0.1 -- they are not secrets, and
# nothing here should ever be pointed at real collection material.
OMEKA_DB_NAME=omeka
OMEKA_DB_USER=omeka
OMEKA_DB_PASSWORD=omeka
OMEKA_DB_ROOT_PASSWORD=omeka-root

# The admin account scripts/install.sh creates. Local demo values again: the
# stack is bound to localhost and is reset whenever a clean start is wanted.
OMEKA_ADMIN_NAME=Demo Admin
OMEKA_ADMIN_EMAIL=admin@example.com
OMEKA_ADMIN_PASSWORD=tetrak-demo
